rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.uid == 'b6BsG4T4z5ZfhSsybus6pcakEdB2' ||
        request.auth.token.email == 'divakarkumarmob@gmail.com' || 
        request.auth.token.email == 'shashikumarmob@gmail.com' ||
        request.auth.token.email == 'admin@neet.com'
      );
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    match /notifications {
      allow read, write: if true;
    }

    match /neet_notifications/{notificationId} {
      allow read, write: if true;
    }
    match /neet_notifications {
      allow read, write: if true;
    }

    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /tests {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /otps/{otpId} {
        allow read, write: if true;
    }
    
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); 
    }
    
    match /chapterActivity/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /users {
      allow read, write: if true;
    }

    match /user_reading_progress/{docId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /chats {
      allow read, write: if true;
    }

    // Community Posts (Cloud Allowed)
    match /communityPosts/{postId} {
      allow read, create, update, delete: if true;

      match /comments/{commentId} {
        allow read, create, update, delete: if true;
      }
    }

    // Study Rooms
    match /studyRooms/{roomId} {
      allow read, create, update, delete: if true;

      match /messages/{messageId} {
        allow read, create, update, delete: if true;
      }
    }

    // User Reports
    match /userReports/{reportId} {
      allow read, create, update: if true;
    }

    // Admin Notifications
    match /adminNotifications/{notifId} {
      allow read, create, update: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

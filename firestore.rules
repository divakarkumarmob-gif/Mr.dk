rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function isAdmin() { 
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }
    match /notifications {
      allow read, write: if isSignedIn();
    }

    // NEET Notifications (Public read, Admin write)
    match /neet_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /neet_notifications {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tests
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /tests {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // OTPs (Required for authentication flow)
    match /otps/{otpId} {
      allow read, write: if true;
    }
    
    // Questions
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); 
    }
    
    // Chapter Activity
    match /chapterActivity/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Reading Progress
    match /user_reading_progress/{docId} {
      allow read, write: if isSignedIn();
    }

    // Users Collection (Owner or Admin access)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    match /users {
      allow read: if isAdmin();
    }

    // Chats Collection (Participant or Admin access)
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && exists(/databases/$(database)/documents/chats/$(chatId))
          && get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []).hasAny([request.auth.uid]);
      }

      function canAccessChat() {
        return isSignedIn() && (
          isAdmin() ||
          chatId == request.auth.uid ||
          isParticipant()
        );
      }

      allow read: if canAccessChat();
      allow create: if isSignedIn() && (chatId == request.auth.uid || request.resource.data.get('participants', []).hasAny([request.auth.uid]));
      allow update: if canAccessChat();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if canAccessChat();
      }
    }
    match /chats {
      allow read: if isAdmin();
    }


    // Community Posts (Public read, Auth required for write operations)
    match /communityPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
      }
    }

    // Study Rooms (Auth required)
    match /studyRooms/{roomId} {
      allow read, create, update, delete: if isSignedIn();

      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    // User Reports (Auth create, Admin read)
    match /userReports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Admin Notifications (Auth create, Admin read)
    match /adminNotifications/{notifId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Default catch-all rule (Block unhandled routes)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function isAdmin() { 
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Notifications (Broadcast read/update readBy for signed-in users, write for admin)
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn();
      allow create, delete: if isAdmin();
    }
    match /notifications {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // NEET Notifications (Public read, Admin write)
    match /neet_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /neet_notifications {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tests
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /tests {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // OTPs (Backend Admin SDK only - direct client access locked down)
    match /otps/{otpId} {
      allow read, write: if false;
    }
    
    // Questions
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); 
    }
    
    // Chapter Activity
    match /chapterActivity/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Reading Progress
    match /user_reading_progress/{docId} {
      allow read, write: if isSignedIn();
    }

    // Users Collection (Public read for signed-in users, owner/admin for write)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      // E2EE X3DH Key Bundle (identity signing key + signed prekey).
      // Publicly readable by any signed-in user so they can start a
      // Double Ratchet session with this user; only the owner (or admin)
      // can publish/update it.
      match /e2ee/keyBundle {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      // E2EE One-Time PreKeys (X3DH). Any signed-in user may READ a single
      // prekey to claim it when starting a new session, and DELETE it once
      // claimed (consumed one-time use). Only the owner may CREATE new
      // prekeys (replenishing their own stock) or bulk-manage them.
      match /e2ee_one_time_prekeys/{keyId} {
        allow read, delete: if isSignedIn();
        allow create, update: if isOwner(userId) || isAdmin();
      }
    }
    match /users {
      allow read: if isSignedIn();
    }

    // Direct Chats Collection (1v1 E2EE Chats Participant access)
    match /directChats/{chatId} {
      function isDirectParticipant() {
        return isSignedIn() && (
          (resource != null && resource.data.get('participants', []).hasAny([request.auth.uid])) ||
          (request.resource != null && request.resource.data.get('participants', []).hasAny([request.auth.uid])) ||
          chatId.matches(".*" + request.auth.uid + ".*")
        );
      }

      allow read, create, update: if isSignedIn() && (
        isDirectParticipant() || isAdmin()
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, create, update: if isSignedIn() && (
          isDirectParticipant() || isAdmin()
        );
        allow delete: if isAdmin();
      }
    }
    match /directChats {
      allow read: if isSignedIn();
    }

    // Legacy Chats Collection (Participant or Admin access)
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && exists(/databases/$(database)/documents/chats/$(chatId))
          && get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []).hasAny([request.auth.uid]);
      }

      function canAccessChat() {
        return isSignedIn() && (
          isAdmin() ||
          chatId == request.auth.uid ||
          chatId == (request.auth.uid + "_ai") ||
          isParticipant()
        );
      }

      allow read: if canAccessChat();
      allow create: if isSignedIn() && (chatId == request.auth.uid || chatId == (request.auth.uid + "_ai") || request.resource.data.get('participants', []).hasAny([request.auth.uid]));
      allow update: if canAccessChat();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if canAccessChat();
      }
    }
    match /chats {
      allow read: if isAdmin();
    }


    // Community Posts (Public read, owner/admin for update and delete)
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('authorId', '') == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
      }
    }

    // Study Rooms (Member-only access and message authorization)
    match /studyRooms/{roomId} {
      function isRoomMember() {
        return isSignedIn() && resource != null && resource.data.get('members', []).hasAny([request.auth.uid]);
      }

      allow read, update: if isRoomMember() || isAdmin();
      allow create: if isSignedIn() && request.resource.data.get('members', []).hasAny([request.auth.uid]);
      allow delete: if isRoomMember() || isAdmin();

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && get(/databases/$(database)/documents/studyRooms/$(roomId)).data.get('members', []).hasAny([request.auth.uid]);
      }

      // E2EE Sender Key Distribution Messages (group Double Ratchet /
      // Sender Keys protocol). Each doc is a chain key sealed for ONE
      // specific recipient - only that recipient may read it, and only
      // the sender who created it may write/delete it. Both must be
      // current room members.
      match /senderKeyDistributions/{distId} {
        function isCurrentRoomMember() {
          return isSignedIn() && get(/databases/$(database)/documents/studyRooms/$(roomId)).data.get('members', []).hasAny([request.auth.uid]);
        }

        allow read: if isCurrentRoomMember() && resource.data.recipientUid == request.auth.uid;
        allow create: if isCurrentRoomMember() && request.resource.data.senderUid == request.auth.uid;
        allow delete: if isCurrentRoomMember() && (resource.data.senderUid == request.auth.uid || isAdmin());
      }
    }

    // User Reports (Auth create, Admin read)
    match /userReports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Admin Notifications (Auth create, Admin read)
    match /adminNotifications/{notifId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Default catch-all rule (Block unhandled routes)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

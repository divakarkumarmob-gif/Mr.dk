<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_pill_background"
    android:paddingLeft="16dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_search_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Ask Google Gemini AI... 🔍"
        android:textColor="#cbd5e1"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_camera_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_camera"
        android:contentDescription="Camera Doubt" />

    <ImageView
        android:id="@+id/widget_voice_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:contentDescription="Voice Tutor" />
</LinearLayout>
